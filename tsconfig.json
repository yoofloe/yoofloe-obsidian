{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": [
      "node",
      "obsidian"
    ]
  },
  "include": [
    "src/main.ts",
    "calendar-companion/src/**/*.ts"
  ]
}
