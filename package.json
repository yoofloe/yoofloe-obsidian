{
  "name": "obsidian-yoofloe",
  "version": "0.6.0",
  "description": "Question-first local Yoofloe Calendar retrieval and optional OpenAI drafts for Android Obsidian.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node calendar-companion/build.mjs --test && node --test calendar-companion/tests/*.test.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "lint": "eslint calendar-companion/src src/main.ts",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.2.4",
    "globals": "^17.5.0",
    "obsidian": "^1.11.5",
    "typescript": "^5.8.3"
  }
}
